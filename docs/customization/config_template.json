{
  "basic": {
    "enable_rvc": true,
    "chorus_seconds": 25,
    "render_mode": "chorus",
    "inference_timeout": 600,
    "default_key_shift": 0
  },
  "selection": {
    "auto_pick_song": true,
    "auto_pick_fallback_menu": true,
    "auto_pick_model": true,
    "auto_pick_min_score": 45.0,
    "auto_pick_min_margin": 8.0,
    "source_order": [
      "netease",
      "kugou",
      "kuwo",
      "qqmusic"
    ],
    "timeout": 30,
    "smart": {
      "enable_smart_cover": true,
      "enable_enhanced_context": true,
      "enable_confirm_mechanism": true,
      "enable_batch_cover": true,
      "enable_preference_learning": true,
      "llm_force_mode": false,
      "enable_inject_context": true,
      "enable_llm_success_notify": true,
      "notify_progress": false,
      "notify_retry": false,
      "enable_config_report": true
    }
  },
  "rvc": {
